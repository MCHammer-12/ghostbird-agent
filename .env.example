# Core
ENVIRONMENT=development
API_KEY=change-me
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PORT=8000

# Per-client API keys for ghostbird agent routes. When unset, API_KEY above
# reaches every client.
# API_KEYS=[{"key":"key-a","principal_id":"writer_a","client_ids":["vance_kinder"]}]

# LLM (set one provider + LLM_PROVIDER)
# LLM_PROVIDER: openai | anthropic | google | courier
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GOOGLE_AI_MODEL=gemini-2.0-flash

# Courier — self-hosted, OpenAI-compatible inference on Apple silicon.
# COURIER_BASE_URL is the platform root without a path; the client appends
# /v1/chat/completions. COURIER_MODEL is used for structured generation and
# is sent as the OpenAI "model" field (e.g. Inkling).
COURIER_BASE_URL=
COURIER_API_KEY=
COURIER_MODEL=
# Local inference plus a one-off Outlines FSM compile is slower than a hosted
# API; raise this if a large evidence set times out.
COURIER_TIMEOUT_SECONDS=180

# Supabase (optional in development — CRUD API falls back to in-memory storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
