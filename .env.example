# Core
ENVIRONMENT=development
API_KEY=change-me
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PORT=8000

# Ghostbird Track 2
# RETRIEVAL_BACKEND: mock (MockRetrievalService) | track1 (real Track 1 service)
RETRIEVAL_BACKEND=mock
# Preload the synthetic Ghostbird fixture clients into the mock so the demo has
# evidence without uploading first. Leave unset/false for an empty mock.
MOCK_LOAD_FIXTURES=true
# Per-client API keys. When unset, the single API_KEY above reaches every client.
# API_KEYS=[{"key":"key-a","principal_id":"writer_a","client_ids":["vance_kinder"]}]
# Poll count before a fresh upload reports ready (0 = instant).
MOCK_INGESTION_DELAY_POLLS=0

# LLM (set one provider + LLM_PROVIDER)
# LLM_PROVIDER: openai | anthropic | google | courier
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GOOGLE_AI_MODEL=gemini-2.0-flash

# Courier — self-hosted, OpenAI-compatible inference on Apple silicon.
# COURIER_BASE_URL is the platform root without a path; the client appends
# /v1/chat/completions. COURIER_MODEL is used for both anecdote generation and
# draft review, and is sent as the OpenAI "model" field (e.g. Inkling).
COURIER_BASE_URL=
COURIER_API_KEY=
COURIER_MODEL=
# Local inference plus a one-off Outlines FSM compile is slower than a hosted
# API; raise this if a large evidence set times out.
COURIER_TIMEOUT_SECONDS=180

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google (GSuite) — raw JSON or base64-encoded service account
GOOGLE_SERVICE_ACCOUNT_JSON=

# Apify
APIFY_API_TOKEN=

# CRM
HUBSPOT_API_KEY=
PIPEDRIVE_API_TOKEN=

# Email (use one)
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=noreply@example.com

# Generic inbound webhooks
WEBHOOK_SECRET=
