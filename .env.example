# Core
ENVIRONMENT=development
API_KEY=change-me
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PORT=8000

# LLM (set one provider + LLM_PROVIDER)
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GOOGLE_AI_MODEL=gemini-2.0-flash

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google (GSuite) — raw JSON or base64-encoded service account
GOOGLE_SERVICE_ACCOUNT_JSON=

# Apify
APIFY_API_TOKEN=

# CRM
HUBSPOT_API_KEY=
PIPEDRIVE_API_TOKEN=

# Email (use one)
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=noreply@example.com

# Generic inbound webhooks
WEBHOOK_SECRET=
